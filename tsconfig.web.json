{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "firefox-webext-browser"],
    "baseUrl": ".",
    "paths": {
      "~": ["./src"],
      "~/*": ["./src/*"],
      "~~": ["."],
      "~~/*": ["./*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "src/web/**/*.ts",
    "vite.web.config.ts",
    "vite.server.config.ts"
  ],
  "exclude": ["node_modules", ".output", "coverage"]
}
